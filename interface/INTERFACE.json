   "origin": "vendor/beethoven-qa/ORIGIN"
  },
  {
   "repository": "OpenSpineConsortium/beethoven-qa",
   "export": "cli",
   "version": 3,
   "into": "vendor/beethoven-qa",
   "origin": "vendor/beethoven-qa/ORIGIN"
  },
  {
   "repository": "OpenSpineConsortium/beethoven-qa",
   "export": "kit",
   "version": 3,
   "into": "vendor/beethoven-qa",
   "origin": "vendor/beethoven-qa/ORIGIN"
  },
  {
   "repository": "OpenSpineConsortium/beethoven-qa",
   "export": "plugin",
   "version": 1,
   "into": "vendor/beethoven-qa",
   "origin": "vendor/beethoven-qa/ORIGIN"
  },
  {
   "repository": "OpenSpineConsortium/hpcworker",
   "export": "profiles",
   "version": 1,
   "into": "profiles",
   "origin": "profiles/ORIGIN"
  },
  {
   "repository": "OpenSpineConsortium/hpcworker",
   "export": "contract",
   "version": 1,
   "into": "contract",
   "origin": "contract/ORIGIN"
  }
 ]
}
