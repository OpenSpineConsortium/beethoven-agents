# Pixi's solved environment: reconstructable from pixi.lock, never committed.
.pixi/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Apptainer images are large and are built on the grid or in CI from containers/*.def, not committed.
# The image's recorded digest (containers/*.sif.sha256) IS committed; the .sif itself is not.
*.sif

# Secrets never enter the repository (see CLAUDE.md). The real values live in the environment.
.env
.env.*
*.pem

# The evidence report's default directory (`pixi run --locked report`, beethoven-qa's
# docs/REPORT.md): it is handed over, never committed, and an untracked folder would make the
# pre-push hook refuse the next push.
report/

# Worktrees Claude Code creates for parallel sessions and isolated subagents (docs/PARALLEL.md).
.claude/worktrees/

# The file Claude Code writes on an "always allow" answer: one person's permissions, never shared,
# and an untracked file would make the pre-push hook refuse every push from that checkout.
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.log
